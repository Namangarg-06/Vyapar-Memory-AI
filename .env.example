# ==============================================================================
# Vyapar Memory AI — Environment Configuration (.env.example)
# Copy this file to .env (or backend/.env) and fill in your credentials.
# NEVER commit your actual .env file or API keys to GitHub.
# ==============================================================================

# --- Application & Security ---
APP_NAME="Vyapar Memory AI"
APP_ENV="development"
SECRET_KEY="change-this-to-a-secure-random-64-char-hex-string-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_TIMEZONE="Asia/Kolkata"

# --- Database Configuration ---
# Option A (Local Zero-Setup Development Mode — SQLite + Local Vector Search):
DATABASE_URL="sqlite:///./vyapar_memory.db"

# Option B (PostgreSQL 16 + pgvector via Docker Compose or Managed DB):
# DATABASE_URL="postgresql+psycopg://vyapar:vyapar_password@localhost:5432/vyapar_memory"

# --- AI & LLM Provider Configuration ---
# Supported values: "gemini", "openai", "auto"
AI_PROVIDER="auto"

# Google Gemini API Key (for Structured Extraction, Embeddings, RAG & Audio STT)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# OpenAI API Key (Alternative provider for Extraction, Embeddings, RAG & Whisper STT)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Speech-to-Text & OCR Configuration ---
# Supported values: "gemini", "openai_whisper", "auto"
STT_PROVIDER="auto"
OCR_ENABLED="true"

# --- File Upload Limits ---
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=15

# --- Frontend Configuration ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
